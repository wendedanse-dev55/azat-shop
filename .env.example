# Copy this file to .env and adjust the values.

# --- Database (PostgreSQL, e.g. Neon) ---
# Neon dashboard → "Connection string".
# DATABASE_URL = the POOLED string (host contains "-pooler"), used at runtime.
# DIRECT_URL   = the UNPOOLED/direct string (no "-pooler"), used by prisma db push.
# Locally you can point both at the same Neon database (or a Neon dev branch).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"

# --- File uploads (Vercel Blob) ---
# Set automatically on Vercel once a Blob store is linked to the project.
# Leave EMPTY locally — uploads then fall back to the ./uploads folder on disk.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Admin panel ---
ADMIN_PASSWORD="admin123"
# Secret used to sign the admin session cookie (use a long random string).
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Telegram order notifications (optional) ---
# Create a bot via @BotFather → it gives you the token below.
# TELEGRAM_CHAT_ID = your Telegram user id (message @userinfobot to get it) or a
# group id. Several recipients can be listed comma-separated.
# Leave empty to disable notifications.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
